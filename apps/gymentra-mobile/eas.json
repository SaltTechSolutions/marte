{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development-device"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://api.gymentra.salt-tech-apps.com"
      }
    },
    "simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "autoIncrement": false,
      "channel": "simulator",
      "env": {
        "EXPO_PUBLIC_BACKEND": "api",
        "EXPO_PUBLIC_API_URL": "https://gymentra-api-staging.tarkan-cicek.workers.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./secrets/AuthKey_8MGK76S6ZD.p8",
        "ascApiKeyId": "8MGK76S6ZD",
        "ascApiKeyIssuerId": "8048df28-6b46-4f4f-a5b1-df5359ad2f4b",
        "ascAppId": "6802950274"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
