{
  // The top level is deliberately a PLACEHOLDER: its D1 id is REPLACE_ON_CREATE, so a bare
  // `wrangler deploy` (no --env) fails instead of reaching production. Deploy only with an
  // explicit `--env staging` or `--env production`. Migrations always run before the Worker.
  // Wrangler does not inherit vars/bindings/triggers into an env, so each env lists its own.
  "name": "gymentra-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte" },
  "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-prod" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "gymentra-prod", "database_id": "REPLACE_ON_CREATE", "migrations_dir": "migrations" }
  ],
  "env": {
    // Production. Not deployed yet: the D1 id is filled in after `d1 create` (docs/CUTOVER.md).
    // API_OPEN is intentionally NOT set here: the Worker answers 503 "maintenance" on every /v1 route
    // (except the RevenueCat webhook) until the owner sets API_OPEN to "1" after import + reconcile.
    "production": {
      "name": "gymentra-api",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.gymentra.salt-tech-apps.com", "custom_domain": true }],
      "observability": { "enabled": true },
      "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte", "PUBLIC_BASE_URL": "https://api.gymentra.salt-tech-apps.com" },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
      // The EU jurisdiction is fixed when the bucket is created (`r2 bucket create ... --jurisdiction eu`).
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-prod", "jurisdiction": "eu" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "gymentra-prod", "database_id": "REPLACE_ON_CREATE", "migrations_dir": "migrations" }
      ]
    },
    "staging": {
      "name": "gymentra-api-staging",
      "observability": { "enabled": true },
      // API_OPEN "1" keeps staging open; see the maintenance gate in src/index.ts.
      "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte", "API_OPEN": "1" },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "gymentra-staging", "database_id": "8ccc4262-104a-4064-9081-0a5810b519f1", "migrations_dir": "migrations" }
      ]
    }
  }
}
