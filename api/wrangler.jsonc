{
  // The top level is deliberately a PLACEHOLDER: its Worker name can never be production's and its D1 id
  // is REPLACE_ON_CREATE, so a bare `wrangler deploy` (no --env) should fail (Cloudflare rejects the
  // placeholder id; dry-run does not check this) and in no case overwrites the production Worker.
  // Deploy only with an explicit `--env staging` or `--env production`.
  // Not in this file by design: secrets (REVENUECAT_WEBHOOK_SECRET) and the exercise-report
  // recipient EXERCISE_REPORT_TO: set those per environment as secrets (`wrangler secret put`); a plain
  // dashboard variable is reset by the next deploy because this file defines vars.
  // Migrations always run before the Worker.
  // Wrangler does not inherit vars/bindings/triggers into an env, so each env lists its own.
  "name": "gymentra-api-unconfigured-do-not-deploy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte" },
  "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-prod" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "gymentra-prod", "database_id": "REPLACE_ON_CREATE", "migrations_dir": "migrations" }
  ],
  "env": {
    // Production. Not deployed yet: the D1 id is filled in after `d1 create` (docs/CUTOVER.md).
    // API_OPEN is "1" because production starts empty (no data migration, owner decision 2026-10-29), so
    // the maintenance gate is not needed at launch. The gate stays in src/index.ts for emergencies: set
    // API_OPEN to "0" here and deploy, and every /v1 route (except the RevenueCat webhook) answers 503.
    "production": {
      "name": "gymentra-api",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "api.gymentra.salt-tech-apps.com", "custom_domain": true }],
      "observability": { "enabled": true },
      "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte", "PUBLIC_BASE_URL": "https://api.gymentra.salt-tech-apps.com", "API_OPEN": "1" },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
      // The EU jurisdiction is fixed when the bucket is created (`r2 bucket create ... --jurisdiction eu`).
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-prod", "jurisdiction": "eu" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "gymentra-prod", "database_id": "006ab9a2-b2f6-453b-8254-faaf59fcf581", "migrations_dir": "migrations" }
      ],
      // Cloudflare Email Service (Beta). Not inherited between envs, so staging lists its own. No
      // allowed_sender_addresses/recipient restriction: the sender is fixed in our own code (a restriction only
      // adds a way to break a send we cannot test here) and the recipient is a secret (EXERCISE_REPORT_TO) resolved at delivery.
      "send_email": [{ "name": "EMAIL" }]
    },
    "staging": {
      "name": "gymentra-api-staging",
      "observability": { "enabled": true },
      // API_OPEN "1" keeps staging open; see the maintenance gate in src/index.ts.
      "vars": { "FIREBASE_PROJECT_ID": "tarabyamarte", "API_OPEN": "1" },
      "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5 21 * * *"] },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gymentra-media-staging" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "gymentra-staging", "database_id": "8ccc4262-104a-4064-9081-0a5810b519f1", "migrations_dir": "migrations" }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
